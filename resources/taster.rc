// Ресурсы Windows программы дегустатора: значок и сведения о версии
#pragma code_page(65001)
#include <winver.h>

IDI_ICON1 ICON "sedm.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName",      "МГТУ им. Н.Э. Баумана, кафедра ИУ6"
            VALUE "FileDescription",  "СЭДМ — программа дегустатора"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "sedm_taster"
            VALUE "OriginalFilename", "sedm_taster.exe"
            VALUE "ProductName",      "СЭДМ — программная система экспертной дегустации мёда"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
